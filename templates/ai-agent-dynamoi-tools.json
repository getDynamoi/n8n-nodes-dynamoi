{
  "name": "Chat with an AI agent that creates Smart Links and reports results",
  "nodes": [
    {
      "id": "how-it-works",
      "name": "How it works",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -340
      ],
      "parameters": {
        "content": "## How it works\nChat with an agent that can look up your artists, create Smart Links from Spotify releases and report Smart Link, audience and campaign results. The agent fills in the artist and Spotify URL itself.",
        "width": 380,
        "height": 210
      }
    },
    {
      "id": "setup",
      "name": "Setup",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        380,
        -340
      ],
      "parameters": {
        "content": "## Setup\n1. Connect your Dynamoi account on each Dynamoi tool.\n2. Connect a chat model. OpenAI is shown here, and any chat model works.\n3. Open the chat and ask, for example, \"How did my campaigns do this week?\"",
        "width": 380,
        "height": 210
      }
    },
    {
      "id": "requirements",
      "name": "Requirements",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        800,
        -340
      ],
      "parameters": {
        "content": "## Requirements\n- A Dynamoi account with an artist\n- A chat model account",
        "width": 280,
        "height": 210
      }
    },
    {
      "id": "when-chat-message-received",
      "name": "When Chat Message Received",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ],
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "ai-agent",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3,
      "position": [
        420,
        0
      ],
      "parameters": {
        "promptType": "auto",
        "text": "={{ $json.chatInput }}",
        "options": {
          "systemMessage": "You help a music artist or label manager with their Dynamoi account. Use the Dynamoi tools to find artists, create Smart Links from Spotify releases, and read Smart Link, audience and campaign results. Answer briefly and include the Smart Link URL whenever you create or find one."
        }
      }
    },
    {
      "id": "chat-model",
      "name": "Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        140,
        300
      ],
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "list-artists",
      "name": "List Artists",
      "type": "n8n-nodes-dynamoi.dynamoiTool",
      "typeVersion": 1,
      "position": [
        300,
        300
      ],
      "parameters": {
        "resource": "artist",
        "operation": "list",
        "returnAll": true,
        "descriptionType": "manual",
        "toolDescription": "List the artists in the Dynamoi account. Use this first to find an artist ID."
      }
    },
    {
      "id": "create-smart-link",
      "name": "Create Smart Link",
      "type": "n8n-nodes-dynamoi.dynamoiTool",
      "typeVersion": 1,
      "position": [
        520,
        300
      ],
      "parameters": {
        "resource": "smartLink",
        "operation": "createFromRelease",
        "artistId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $fromAI('artistId', 'Artist ID from the List Artists tool', 'string') }}"
        },
        "spotifyUrl": "={{ $fromAI('spotifyUrl', 'Spotify album or track URL', 'string') }}",
        "descriptionType": "manual",
        "toolDescription": "Create a Smart Link from a Spotify release URL for an artist. Use List Artists first for the artist ID."
      }
    },
    {
      "id": "get-smart-links",
      "name": "Get Smart Links",
      "type": "n8n-nodes-dynamoi.dynamoiTool",
      "typeVersion": 1,
      "position": [
        740,
        300
      ],
      "parameters": {
        "resource": "smartLink",
        "operation": "list",
        "artistId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $fromAI('artistId', 'Artist ID from the List Artists tool', 'string') }}"
        },
        "returnAll": false,
        "limit": 10,
        "descriptionType": "manual",
        "toolDescription": "List an artist's Smart Links with their public URLs. Use List Artists first for the artist ID."
      }
    },
    {
      "id": "get-artist-analytics",
      "name": "Get Artist Analytics",
      "type": "n8n-nodes-dynamoi.dynamoiTool",
      "typeVersion": 1,
      "position": [
        960,
        300
      ],
      "parameters": {
        "resource": "analytics",
        "operation": "getArtist",
        "artistId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $fromAI('artistId', 'Artist ID from the List Artists tool', 'string') }}"
        },
        "options": {
          "startDate": "={{ $fromAI('startDate', 'First day to include, as YYYY-MM-DD', 'string') }}",
          "endDate": "={{ $fromAI('endDate', 'Last day to include, as YYYY-MM-DD', 'string') }}",
          "granularity": "TOTAL"
        },
        "descriptionType": "manual",
        "toolDescription": "Get campaign clicks and impressions for an artist over a date range. Use List Artists first for the artist ID."
      }
    },
    {
      "id": "get-audience-analytics",
      "name": "Get Audience Analytics",
      "type": "n8n-nodes-dynamoi.dynamoiTool",
      "typeVersion": 1,
      "position": [
        1180,
        300
      ],
      "parameters": {
        "resource": "analytics",
        "operation": "getAudience",
        "artistId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $fromAI('artistId', 'Artist ID from the List Artists tool', 'string') }}"
        },
        "range": "={{ $fromAI('range', 'One of 7d, 30d or 90d', 'string') }}",
        "descriptionType": "manual",
        "toolDescription": "Get streaming audience by country and service for an artist. Use List Artists first for the artist ID."
      }
    },
    {
      "id": "get-campaigns",
      "name": "Get Campaigns",
      "type": "n8n-nodes-dynamoi.dynamoiTool",
      "typeVersion": 1,
      "position": [
        1400,
        300
      ],
      "parameters": {
        "resource": "campaign",
        "operation": "list",
        "artistId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $fromAI('artistId', 'Artist ID from the List Artists tool', 'string') }}"
        },
        "returnAll": false,
        "limit": 10,
        "descriptionType": "manual",
        "toolDescription": "List campaigns for an artist with their status. Use List Artists first for the artist ID."
      }
    },
    {
      "id": "chat-memory",
      "name": "Chat Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        1620,
        300
      ],
      "parameters": {}
    }
  ],
