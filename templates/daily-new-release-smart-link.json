{
  "name": "Create Dynamoi Smart Links for new Spotify releases and post them to Discord",
  "nodes": [
    {
      "id": "how-it-works",
      "name": "How it works",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -300
      ],
      "parameters": {
        "content": "## How it works\nEvery morning the workflow asks Dynamoi to create or refresh Smart Links for your Spotify artist, keeps only links it has not posted before, and sends each new link to Discord.",
        "width": 360,
        "height": 210
      }
    },
    {
      "id": "setup",
      "name": "Setup",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        360,
        -300
      ],
      "parameters": {
        "content": "## Setup\n1. Connect your Dynamoi account.\n2. Paste your Spotify artist URL in the Dynamoi node.\n3. Add a Discord webhook credential, or swap the last node for Slack.",
        "width": 340,
        "height": 210
      }
    },
    {
      "id": "requirements",
      "name": "Requirements",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        740,
        -300
      ],
      "parameters": {
        "content": "## Requirements\n- A Dynamoi account\n- A Spotify artist URL\n- A Discord webhook",
        "width": 300,
        "height": 210
      }
    },
    {
      "id": "every-morning",
      "name": "Every Morning",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 9
            }
          ]
        }
      }
    },
    {
      "id": "create-or-refresh-smart-links",
      "name": "Create or Refresh Smart Links",
      "type": "n8n-nodes-dynamoi.dynamoi",
      "typeVersion": 1,
      "position": [
        260,
        0
      ],
      "parameters": {
        "resource": "smartLink",
        "operation": "createForArtist",
        "spotifyArtistUrl": "https://open.spotify.com/artist/REPLACE_WITH_YOUR_ARTIST_ID"
      }
    },
    {
      "id": "split-smart-links",
      "name": "Split Smart Links",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        520,
        0
      ],
      "parameters": {
        "fieldToSplitOut": "smartLinks",
        "options": {}
      }
    },
    {
      "id": "remove-smart-links-already-posted",
      "name": "Remove Smart Links Already Posted",
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 2,
      "position": [
        780,
        0
      ],
      "parameters": {
        "operation": "removeItemsSeenInPreviousExecutions",
        "logic": "removeItemsWithAlreadySeenKeyValues",
        "dedupeValue": "={{ $json.id }}",
        "options": {}
      }
    },
    {
      "id": "post-to-discord",
      "name": "Post to Discord",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        1040,
        0
      ],
      "parameters": {
        "authentication": "webhook",
        "content": "=New Smart Link ready: {{ $json.releaseTitle }} by {{ $json.artistName }}\n{{ $json.publicUrl }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Every Morning": {
      "main": [
        [
          {
            "node": "Create or Refresh Smart Links",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create or Refresh Smart Links": {
      "main": [
        [
          {
            "node": "Split Smart Links",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Smart Links": {
      "main": [
        [
          {
            "node": "Remove Smart Links Already Posted",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Remove Smart Links Already Posted": {
      "main": [
        [
          {
            "node": "Post to Discord",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
