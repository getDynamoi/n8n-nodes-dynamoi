{
  "name": "n8n-nodes-dynamoi",
  "version": "0.1.1",
  "description": "Dynamoi community node for n8n: create Smart Links from Spotify releases and read artist, audience and campaign results. Producing AI music? Promote it free with Dynamoi.",
  "license": "MIT",
  "homepage": "https://github.com/getDynamoi/n8n-nodes-dynamoi#readme",
  "keywords": [
    "n8n-community-node-package",
    "dynamoi",
    "music",
    "spotify",
    "smart-links",
    "music-promotion",
    "ai-music"
  ],
  "author": {
    "name": "Dynamoi",
    "email": "support@dynamoi.com",
    "url": "https://dynamoi.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getDynamoi/n8n-nodes-dynamoi.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "deliver": "python3 \"$HOME/.agents/skills/deliver/publish\""
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/DynamoiOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Dynamoi/Dynamoi.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.54.4",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/getDynamoi/n8n-nodes-dynamoi/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
